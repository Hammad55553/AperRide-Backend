# Supabase pooler connection (async driver)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ENV=development
CORS_ORIGINS=*
# Keep-alive (Render free tier): set to your service /health URL
SELF_PING_URL=https://asperride-backend.onrender.com/health
SELF_PING_INTERVAL_SEC=300
